{
  "name": "@simular-ai/box",
  "version": "0.1.2",
  "description": "Connect box by Simular (a cloud computer your AI agent drives over MCP) to Claude Code, Codex, Cursor, OpenCode, Hermes, OpenClaw and more in one command.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "simular-box": "bin/simular-box.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "test": "node --test",
    "smoke": "node e2e/smoke.mjs",
    "prepack": "node -e \"require('fs').copyFileSync('../LICENSE', 'LICENSE')\""
  },
  "dependencies": {
    "@clack/prompts": "0.11.0",
    "cross-spawn": "7.0.6",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  },
  "homepage": "https://box.simular.ai/install",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simular-ai/box-plugin.git",
    "directory": "cli"
  },
  "bugs": "https://github.com/simular-ai/box-plugin/issues",
  "keywords": [
    "mcp",
    "box",
    "simular",
    "computer-use",
    "claude-code",
    "codex",
    "cursor",
    "opencode",
    "hermes",
    "openclaw"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.14.0"
  }
}
